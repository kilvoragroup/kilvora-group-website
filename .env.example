# Modelo de variáveis de ambiente — NÃO colocar valores reais neste ficheiro.
# Copiar para .env.local (ignorado pelo Git) e preencher apenas localmente.

# URL pública do site (sem barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Desactiva a telemetria anónima do Next.js
NEXT_TELEMETRY_DISABLED=1

# Supabase (W3) — integração em preparação; ainda sem código que a utilize.
# Local: valores obtidos com `npx.cmd supabase status` (nunca colar aqui).
# A chave publishable é pública por natureza e só é segura com RLS activo em todas as tabelas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Não existe chave privilegiada (secret/service_role) na V1: a autorização assenta em
# RLS e funções da base de dados. Qualquer introdução futura exige decisão expressa,
# uso exclusivo no servidor e nunca o prefixo NEXT_PUBLIC_.
