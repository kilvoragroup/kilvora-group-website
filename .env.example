# Modelo de variáveis de ambiente — NÃO colocar valores reais neste ficheiro.
# Copiar para .env.local (ignorado pelo Git) e preencher apenas localmente.

# URL pública do site (sem barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Desactiva a telemetria anónima do Next.js
NEXT_TELEMETRY_DISABLED=1

# Supabase — preparado para W3; integração ainda NÃO activa.
# A chave anon/publishable é pública por natureza, mas só deve ser usada com RLS activo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: exclusivamente no servidor. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
